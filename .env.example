# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# These are public Spline scene URLs for the 3D robot.
# Vite inlines every VITE_* variable into the client bundle at build time,
# so never put real secrets (API keys, tokens) in here.

VITE_ROBOT_1_URL=https://prod.spline.design/YOUR_SCENE_ID/scene.splinecode
VITE_ROBOT_2_URL=https://prod.spline.design/YOUR_SCENE_ID/scene.splinecode
